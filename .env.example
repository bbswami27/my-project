# GitPit Production Environment Configuration
PORT=3001
NODE_ENV=production
APP_NAME=GitPit
APP_URL=https://your-gitpit-domain.onrender.com

# WebRTC STUN/TURN Credentials (Optional for high-volume custom relay)
TURN_SERVER_URL=turn:standard.relay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
